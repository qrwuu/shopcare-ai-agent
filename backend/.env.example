# Required: application identity and API prefix.
PROJECT_NAME=ShopCare Backend
API_V1_STR=/api/v1

# FastAPI/ASGI host and port. BAA_WSGI is a legacy compatibility variable;
# this backend runs with uvicorn, not Waitress.
BAA_HOST=0.0.0.0
AGENT_PORT=18001
BAA_WSGI=waitress

# Development CORS allow-list. Add browser-visible frontend origins only.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required: PostgreSQL. Use db inside Docker Compose; use localhost for host execution.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopcare

# Required: Redis. Use redis inside Docker Compose; use localhost for host execution.
REDIS_HOST=redis
REDIS_PORT=6379

# Optional: defaults to REDIS_URL when left empty.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Required for LangGraph generation. The current client is OpenAI-compatible.
# ANTHROPIC_* names are accepted as gateway aliases in app.core.config only.
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=qwen-plus
ANTHROPIC_BASE_URL=https://example.com/api
ANTHROPIC_AUTH_TOKEN=your-token-here
ANTHROPIC_MODEL=your-model-name
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# Required: JWT configuration. Replace SECRET_KEY before shared use.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: risk and connection settings use application defaults when omitted.
HIGH_RISK_REFUND_AMOUNT=2000
MEDIUM_RISK_REFUND_AMOUNT=500
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_RECONNECT_TIMEOUT=60
STATUS_POLLING_INTERVAL=3
