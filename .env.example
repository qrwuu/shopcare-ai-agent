# FastAPI
PROJECT_NAME=ShopCare
API_V1_STR=/api/v1
BAA_HOST=0.0.0.0
AGENT_PORT=18001
BAA_WSGI=waitress
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL + pgvector
# Docker Compose: use db. For host execution: use localhost.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopcare

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# LLM gateway. Do not put real tokens in this template.
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=qwen-plus
ANTHROPIC_BASE_URL=https://example.com/api
ANTHROPIC_AUTH_TOKEN=your-token-here
ANTHROPIC_MODEL=your-model-name
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# Security
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Next.js browser-visible backend addresses only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:18001
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:18001
API_BASE_URL=http://localhost:18001
